# apps/server env. Copy to apps/server/.env for dev; production keeps its own file on the server (never in git).
# NODE_ENV=production on the server; development by default.
NODE_ENV=development
# Loopback port of the API (dev: 5330; the web dev server on 5331 proxies /api, /auth and /healthz to it).
PORT=5330
# Public origin of the app; the sign-in callback is PUBLIC_URL/auth/callback. Dev: the web dev server.
PUBLIC_URL=http://localhost:5331
# Postgres connection string. Unset: embedded PGlite under .data/pglite (dev only; refused in production).
DATABASE_URL=
# Dev/test only, with DATABASE_URL unset: another PGlite directory, or `memory` for an empty in-memory database.
PGLITE_DIR=
# hoandat.com account (auth-next). Sign-in stays off until AUTH_CLIENT_SECRET is set (guests still play).
AUTH_ISSUER=https://auth.hoandat.com
AUTH_CLIENT_ID=chuanho-web
# Secret of the confidential client chuanho-web (the IdP's CHUANHO_WEB_CLIENT_SECRET). At least 32 characters.
AUTH_CLIENT_SECRET=
